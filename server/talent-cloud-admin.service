[Unit]
Description=Transformation Pixel Dungeon talent cloud admin console
After=network.target talent-cloud.service

[Service]
Type=simple
WorkingDirectory=/opt/tpd-cloud
ExecStart=/usr/bin/python3 /opt/tpd-cloud/admin_console.py --host 0.0.0.0 --port 44142 --db /opt/tpd-cloud/cloud_data/talent_cloud.sqlite3
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
